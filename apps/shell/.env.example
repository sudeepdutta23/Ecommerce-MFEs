# remoteEntry.js URLs for each registered remote.
# In production, point these at each MFE's deployed origin/CDN.
REMOTE_AUTH_DASHBOARD_URL=http://localhost:3001/remoteEntry.js
REMOTE_PRODUCT_CATALOG_URL=http://localhost:3002/remoteEntry.js
REMOTE_ANALYTICS_URL=http://localhost:3003/remoteEntry.js
REMOTE_CART_URL=http://localhost:3004/remoteEntry.js
REMOTE_ORDERS_URL=http://localhost:3005/remoteEntry.js
REMOTE_ADMIN_URL=http://localhost:3006/remoteEntry.js

# API gateway base URL (inlined at build time; used by the @ecom/utils http client).
# In production, point this at the deployed gateway, e.g. https://your-gateway.example.com/api/v1
API_GATEWAY_URL=http://localhost:8080/api/v1
